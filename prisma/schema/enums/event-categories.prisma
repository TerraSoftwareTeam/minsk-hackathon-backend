enum EventCategories {
  SPORTS // спортивные: соревнования, турниры, эстафеты
  INTELLECTUAL // интеллектуальные: олимпиады, квизы, дебаты
  CULTURAL // культурные: театр, музей, кино
  CREATIVE // творческие: концерты, конкурсы, выставки работ
  EDUCATIONAL // образовательные: лекции, мастер-классы, встречи с профессионалами
  VOLUNTEER // волонтёрские и социальные: благотворительность, помощь
  ENVIRONMENTAL // экологические: субботники, посадка деревьев
  TOURISM // туристические: походы, экскурсии, поездки
  ENTERTAINMENT // развлекательные: праздники, дискотеки, квесты
  OTHER // другое
}
