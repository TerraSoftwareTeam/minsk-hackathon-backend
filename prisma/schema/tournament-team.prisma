model TournamentTeam {
  id           String     @id @default(uuid())
  name         String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId     String
  /// Pupil who created the team. Null only if that user account was deleted.
  creator      User?      @relation("TeamCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  creatorId    String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  members TeamMember[]

  gamesAsA      TournamentGame[]    @relation("GameTeamA")
  gamesAsB      TournamentGame[]    @relation("GameTeamB")
  gamesWon      TournamentGame[]    @relation("GameWinner")
  bracketsWon   TournamentBracket[] @relation("BracketWinner")
  tournamentWon Tournament?         @relation("TournamentWinner")

  @@unique([tournamentId, name])
  @@index([schoolId])
}

/// tournamentId is denormalized so that the DB guarantees
/// "a pupil is in at most one team per tournament".
model TeamMember {
  team         TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId String
  joinedAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@id([teamId, userId])
  @@unique([tournamentId, userId])
  @@index([userId])
}
