model User {
  id          String    @id @default(uuid())
  schoolsById String    @unique
  name        String
  surname     String
  class       String?
  role        UserRoles @default(PUPIL)
  /// Pupil's personal progress (experience points, like in Minecraft); never negative.
  exp         Int       @default(0)

  initiatedEvents Event[]       @relation("EventInitiator")
  eventVotes      EventVote[]
  eventLikes      EventLike[]
  uploadedImages  Image[]       @relation("UploadedImages")
  deviceTokens    DeviceToken[]
}
