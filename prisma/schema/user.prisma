model User {
  id          String    @id @default(uuid())
  schoolsById String?   @unique
  name        String
  surname     String
  class       String?
  role        UserRoles @default(PUPIL)

  initiatedEvents Event[]       @relation("EventInitiator")
  teacherEvents   Event[]       @relation("EventTeacher")
  eventVotes      EventVote[]
  eventRatings    EventRating[]
  uploadedImages  Image[]       @relation("UploadedImages")
  deviceTokens    DeviceToken[]
}
