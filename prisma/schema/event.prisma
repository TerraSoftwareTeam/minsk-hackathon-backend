model Event {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  scope       Scopes          @default(CLASS)
  category    EventCategories
  status      EventStatuses   @default(ON_MODERATION)

  declineReason String?

  /// Votes needed to move the event from ON_VOTE to ON_ADMIN_MODERATION. Always >= 1.
  voteThreshold Int

  /// When the event takes place. Pending deadlines are derived from it (event-deadlines.ts).
  startsAt DateTime

  initiator   User   @relation("EventInitiator", fields: [initiatorId], references: [id])
  initiatorId String

  teacher   User   @relation("EventTeacher", fields: [teacherId], references: [id])
  teacherId String

  votes EventVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([initiatorId])
  @@index([teacherId, status])
  @@index([status, startsAt])
}
