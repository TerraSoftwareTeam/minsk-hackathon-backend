model Event {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  scope       Scopes          @default(CLASS)
  category    EventCategories
  status      EventStatuses   @default(ON_MODERATION)

  declineReason String?

  /// Votes (participants) the event needs by the time voting closes to move on from
  /// ON_VOTE (to ON_ADMIN_MODERATION, or FINALIZED for an admin event). Always >= 1.
  voteThreshold Int

  /// Optional cap on participants (pupils who voted, the pupil organizer included);
  /// null = unlimited. Always >= voteThreshold. With it, voting stays open past voteThreshold
  /// until this many pupils joined (the event then moves on at once) or voting closes.
  /// Without it, the vote that reaches voteThreshold moves the event on at once.
  maxParticipants Int?

  /// When the event takes place: chosen by the author on creation, whatever their role,
  /// and never changed (moderators only approve or decline). Present in every status;
  /// only old events rejected before authors chose dates may have none.
  /// It sets the deadlines (event-deadlines.ts): teacher moderation and voting end 3 days
  /// before it, admin moderation when it starts. Voting closes at maxParticipants (voteThreshold when it is null) or at
  /// its deadline: voteThreshold reached -> the event moves on, otherwise EXPIRED. A stage
  /// of moderation not decided by its deadline -> EXPIRED.
  startsAt DateTime?

  initiator   User   @relation("EventInitiator", fields: [initiatorId], references: [id])
  initiatorId String

  /// Role of the initiator when the event was created; it picks the flow:
  /// PUPIL: ON_MODERATION (teachers) -> ON_VOTE -> ON_ADMIN_MODERATION -> FINALIZED.
  /// TEACHER: starts ON_VOTE (no teacher moderation) -> ON_ADMIN_MODERATION -> FINALIZED.
  /// ADMIN: a SCHOOL event, no moderation: ON_VOTE -> FINALIZED when the votes reach
  /// voteThreshold by the time voting closes, EXPIRED otherwise.
  createdByRole UserRoles @default(PUPIL)

  // No moderator column: the moderators are derived from the status. ON_MODERATION:
  // every TEACHER of the initiator's class; ON_ADMIN_MODERATION: every ADMIN.

  votes EventVote[]
  likes EventLike[]

  /// Optional picture: at most one per event (unique). Deleting the image clears it.
  image   Image?  @relation("EventImage", fields: [imageId], references: [id], onDelete: SetNull)
  imageId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([initiatorId])
  @@index([status, createdAt])
  @@index([status, startsAt])
}
