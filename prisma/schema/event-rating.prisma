/// A pupil's rating of an event that took place: 1 to 5 stars, one per pupil per event.
model EventRating {
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  rater   User   @relation(fields: [raterId], references: [id], onDelete: Cascade)
  raterId String

  /// 1..5 (CHECK constraint in the migration).
  stars Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([eventId, raterId])
  @@index([raterId])
}
